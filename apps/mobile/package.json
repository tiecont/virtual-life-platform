{
  "name": "@virtual-city/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:workload":"tsc --noEmit && vite build --mode renderer-workload",
    "build:native-auth":"tsc --noEmit && vite build --mode native-auth-qualification",
    "build:native-world":"tsc --noEmit && vite build --mode native-world-qualification",
    "build:mobile-policy":"tsc --noEmit && vite build --mode native-policy-qualification",
    "build:native-safety":"tsc --noEmit && vite build --mode native-safety-qualification",
    "typecheck": "tsc --noEmit",
    "cap": "cap"
  },
  "dependencies": {
    "@virtual-city/contracts":"workspace:*",
    "@virtual-city/scene3d":"workspace:*",
    "@virtual-city/game-client": "workspace:*",
    "@virtual-city/client-sdk": "workspace:*",
    "@virtual-city/deadline-world": "workspace:*",
    "@virtual-city/maid-world": "workspace:*",
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@virtual-city/pixi-scene": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "vite": "8.3.5"
  }
}
