.arena-panel {
    width: 400px;
    max-width: 98%;
    max-height: 96%;
    margin: 16px;
    padding: 18px;
    background-color: rgba(13, 21, 34, 0.96);
    color: rgb(232, 238, 247);
    border-left-width: 2px;
    border-left-color: rgb(229, 178, 101);
}
.arena-panel Label {
    color: rgb(232, 238, 247);
    white-space: normal;
}
.arena-panel .arena-eyebrow {
    color: rgb(229, 178, 101);
    font-size: 12px;
    -unity-font-style: bold;
}
.arena-panel .arena-title {
    font-size: 25px;
    -unity-font-style: bold;
    margin-top: 4px;
    margin-bottom: 4px;
}
.arena-panel .arena-meta {
    color: rgb(172, 193, 215);
    margin-bottom: 6px;
}
.arena-panel .arena-notice {
    color: rgb(252, 215, 156);
    margin-top: 4px;
    margin-bottom: 6px;
}
.arena-panel Button {
    min-height: 30px;
    margin-top: 3px;
    margin-bottom: 3px;
    background-color: rgb(37, 54, 77);
    color: rgb(232, 238, 247);
    border-color: rgb(66, 89, 115);
    -unity-text-align: middle-left;
    padding-left: 10px;
}
.arena-panel Button:focus {
    border-color: rgb(255, 201, 118);
}
.arena-panel Button:hover {
    background-color: rgb(59, 76, 102);
}
.arena-panel Button:disabled {
    opacity: 0.55;
}
.arena-meter {
    height: 22px;
    margin-bottom: 6px;
}

.coop-hub-actions {
    position: absolute;
    bottom: 12px;
    right: 12px;
    flex-direction: row;
}
.coop-campaign-map {
    margin-bottom: 10px;
}
.coop-campaign-map-name {
    -unity-font-style: bold;
}
.coop-world Label {
    background-color: rgba(15, 23, 38, 0.94);
    color: rgb(242, 236, 217);
    padding-left: 6px;
    white-space: normal;
}
.coop-panel {
    background-color: rgba(16, 24, 38, 0.95);
    padding: 6px;
}
.coop-world #coop-seats { flex-wrap: wrap; }
.coop-member { flex-grow: 1; flex-basis: 22%; min-width: 130px; }
.coop-active-member { border-top-width: 3px; border-top-color: rgb(255, 206, 104); }
.coop-hud-scroll { flex-grow: 1; min-height: 0; }
.coop-footer { flex-direction: row; flex-shrink: 0; }
.coop-footer-button { flex-basis: 0; flex-grow: 1; }
.coop-footer-hidden { visibility: hidden; }
.coop-world #coop-turn, .coop-world #coop-boss, .coop-world #coop-telegraph {
    color: rgb(255, 217, 148);
    -unity-font-style: bold;
}
.coop-board {
    flex-direction: row;
    flex-wrap: wrap;
    width: 520px;
}
.coop-tile {
    width: 58px;
    height: 48px;
    margin-right: 2px;
    margin-bottom: 2px;
    color: white;
    -unity-font-style: bold;
}
.coop-tile.coop-element-tile { color: rgba(0, 0, 0, 0); }
.coop-element-icon {
    position: absolute;
    width: 29px;
    height: 29px;
    left: 13px;
    top: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
.coop-tile-multiplied .coop-element-icon {
    width: 20px;
    height: 20px;
    left: 0;
    top: 14px;
}
.coop-world .coop-tile-multiplier {
    position: absolute;
    top: 0;
    right: 0;
    color: rgb(255, 235, 175);
    background-color: rgb(37, 32, 41);
    border-bottom-left-radius: 5px;
    padding-left: 3px;
    padding-right: 3px;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
}
.tile-fire { background-color: rgb(142, 58, 37); }
.tile-water { background-color: rgb(35, 93, 134); }
.tile-electric { background-color: rgb(130, 93, 24); }
.tile-ghost { background-color: rgb(89, 60, 126); }
.tile-ground { background-color: rgb(105, 78, 55); }
.tile-light { background-color: rgb(56, 111, 91); }
.tile-fire .coop-element-icon {
    background-image: url("ElementTiles/fire.png");
    -unity-background-image-tint-color: rgb(255, 206, 156);
}
.tile-water .coop-element-icon {
    background-image: url("ElementTiles/water.png");
    -unity-background-image-tint-color: rgb(190, 237, 255);
}
.tile-electric .coop-element-icon {
    background-image: url("ElementTiles/electric.png");
    -unity-background-image-tint-color: rgb(255, 237, 166);
}
.tile-ghost .coop-element-icon {
    background-image: url("ElementTiles/ghost.png");
    -unity-background-image-tint-color: rgb(238, 215, 255);
}
.tile-ground .coop-element-icon {
    background-image: url("ElementTiles/ground.png");
    -unity-background-image-tint-color: rgb(255, 221, 186);
}
.tile-light .coop-element-icon {
    background-image: url("ElementTiles/light.png");
    -unity-background-image-tint-color: rgb(223, 255, 215);
}
.coop-selected { border-width: 3px; border-color: white; }

.training-list {
    min-height: 0;
    flex-shrink: 1;
}
.training-card {
    margin-top: 6px;
    padding: 8px;
    background-color: rgb(28, 40, 57);
    border-left-width: 2px;
    border-left-color: rgb(147, 122, 83);
}
.arena-panel .training-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 217, 148);
}
