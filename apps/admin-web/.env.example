# Operator console is unavailable until both origins are explicitly configured.
# ADMIN_ORIGIN=https://your-private-admin-origin
# ADMIN_API_ORIGIN=https://your-private-platform-api-origin
# Optional read-only telemetry credential; omit for UNKNOWN metrics.
# ADMIN_METRICS_READ_TOKEN=<separate-service-read-token>
# API bootstrap/encryption keys, database and cluster credentials do not belong here.
# For loopback development only, use http://127.0.0.1:3400 and :4300.
