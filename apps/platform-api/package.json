{
  "name": "@virtual-city/platform-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "worker": "node dist/worker.js",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "node ../../scripts/clean-api-output.mjs && tsc -p tsconfig.json && node ../../scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/shared/database/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@virtual-city/contracts": "workspace:*",
    "@virtual-city/boardgame-core": "workspace:*",
    "@virtual-city/library-world": "workspace:*",
    "@virtual-city/park-world": "workspace:*",
    "@virtual-city/deadline-world":"workspace:*",
    "@virtual-city/maid-world":"workspace:*",
    "@virtual-city/lantern-lodge-world":"workspace:*",
    "@virtual-city/lounge-world": "workspace:*",
    "@virtual-city/restaurant-world": "workspace:*",
    "@virtual-city/world-sdk": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  }
}
