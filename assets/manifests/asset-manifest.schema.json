{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheria.invalid/schemas/asset-manifest.schema.json",
  "title": "Aetheria private asset manifest",
  "description": "Metadata for one private S3/Tigris asset. A manifest never grants publication, ownership, rights, or release approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "stage",
    "s3Key",
    "sha256",
    "sizeBytes",
    "contentType",
    "localCachePath"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "stage": {
      "type": "string",
      "enum": ["reference", "blockout", "candidate", "review", "delivery"]
    },
    "s3Key": {
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9._/-]+$",
      "minLength": 8,
      "maxLength": 512
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "contentType": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
    },
    "localCachePath": {
      "type": "string",
      "pattern": "^\\.cache/assets/[A-Za-z0-9._/-]+$",
      "minLength": 14,
      "maxLength": 512
    }
  }
}
