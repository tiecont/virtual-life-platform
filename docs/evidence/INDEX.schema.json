{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private project evidence byte index",
  "type": "object",
  "required": ["schemaVersion", "snapshotRevision", "createdAt", "archive", "policy", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "snapshotRevision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "archive": {
      "type": "object", "required": ["format", "keyId", "objectCount", "totalSourceBytes"],
      "properties": {
        "format": {"const": "VLPEVID1-AES-256-GCM"},
        "keyId": {"type": "string", "format": "uuid"},
        "objectCount": {"type": "integer", "minimum": 1, "maximum": 10000},
        "totalSourceBytes": {"type": "integer", "minimum": 0, "maximum": 268435456}
      }
    },
    "policy": {
      "type": "object", "required": ["classification", "originalsRetained", "cleanupAuthorized", "retention"],
      "properties": {
        "classification": {"const": "restricted-project-test-evidence"},
        "originalsRetained": {"const": true},
        "cleanupAuthorized": {"const": false},
        "retention": {"type": "string"}
      }
    },
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "required": ["path", "bytes", "sha256", "cipherSha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^docs/agent/evidence/[a-zA-Z0-9][a-zA-Z0-9._/-]*$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "cipherSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
