{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationEvidence",
  "type": "object",
  "required": [
    "id",
    "taskId",
    "sourceRevision",
    "environment",
    "executedAt",
    "commands",
    "artifacts",
    "acceptance_met",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "taskId": {
      "type": "string",
      "pattern": "^N[0-9]{2}-[0-9]{2}$"
    },
    "sourceRevision": {
      "type": "string",
      "description": "Commit SHA or workspace diff hash; never a planned fake SHA"
    },
    "environment": {
      "type": "string"
    },
    "executedAt": {
      "type": "string",
      "format": "date-time"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exitCode"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exitCode": {
            "type": "integer"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "outcome"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "retention": {
            "type": "string"
          },
          "access": {
            "enum": [
              "private",
              "sanitized-public"
            ]
          }
        }
      }
    },
    "acceptance_met": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

