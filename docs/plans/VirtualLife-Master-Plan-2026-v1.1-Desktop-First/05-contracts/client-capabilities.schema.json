{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VirtualLife client capability negotiation",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "platform", "clientVersion", "catalogHash", "qualityProfile", "features"],
  "properties": {
    "protocolVersion": {"type": "integer", "minimum": 1},
    "platform": {"type": "string", "enum": ["windows", "macos", "linux", "android", "ios", "web-lite"]},
    "clientVersion": {"type": "string", "minLength": 1},
    "catalogHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualityProfile": {"type": "string", "enum": ["low", "balanced", "ultra", "photo", "web-lite"]},
    "features": {"type": "array", "items": {"type": "string", "maxLength": 64}, "uniqueItems": true, "maxItems": 64},
    "locale": {"type": "string", "maxLength": 16}
  }
}
