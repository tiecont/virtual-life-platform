      "triageTargetMinutes": 4320,
      "allowedSanctions": [
        "warn",
        "mute"
      ]
    },
    "medium": {
      "triageTargetMinutes": 1440,
      "allowedSanctions": [
        "warn",
        "mute",
        "room-eject"
      ]
    },
    "high": {
      "triageTargetMinutes": 60,
      "allowedSanctions": [
        "mute",
        "room-eject",
        "world-ban"
      ]
    },
    "critical": {
      "triageTargetMinutes": 15,
      "allowedSanctions": [
        "mute",
        "room-eject",
        "world-ban",
        "platform-ban"
      ]
    }
  },
  "sanctions": {
    "reasonRequired": true,
    "evidenceReferenceRequired": true,
    "appealReceiptRequired": true,
    "permanentBanRequiresIndependentReview": true,
    "staffRoleFromClient": false,
    "maxMuteHours": 24,
