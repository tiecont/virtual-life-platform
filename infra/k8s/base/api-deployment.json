{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "vlp-api",
    "labels": {
      "app.kubernetes.io/part-of": "virtual-life-platform",
      "app.kubernetes.io/name": "vlp-api"
    }
  },
  "spec": {
    "replicas": 1,
    "revisionHistoryLimit": 2,
    "progressDeadlineSeconds": 180,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/part-of": "virtual-life-platform",
        "app.kubernetes.io/name": "vlp-api"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/part-of": "virtual-life-platform",
          "app.kubernetes.io/name": "vlp-api"
        }
      },
      "spec": {
        "serviceAccountName": "vlp-runtime",
        "automountServiceAccountToken": false,
        "enableServiceLinks": false,
        "hostNetwork": false,
        "nodeSelector": {
          "kubernetes.io/os": "linux",
          "kubernetes.io/arch": "amd64"
        },
        "imagePullSecrets": [
          {
            "name": "vlp-registry-pull"
          }
        ],
        "terminationGracePeriodSeconds": 20,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "api",
            "image": "registry.invalid/vlp-api:release-required",
            "imagePullPolicy": "Always",
            "command": [
              "node",
              "dist/main.js"
            ],
            "ports": [
              {
                "name": "http",
                "containerPort": 4300
              }
            ],
            "env": [
              {
                "name": "NODE_ENV",
                "value": "production"
              },
              {
                "name": "HOST",
                "value": "0.0.0.0"
              },
              {
                "name": "PORT",
                "value": "4300"
              },
              {
                "name": "DURABLE_JOB_ROLE",
                "value": "api"
              },
              {
                "name": "WEB_ORIGIN",
                "valueFrom": {
                  "configMapKeyRef": {
                    "name": "vlp-runtime",
                    "key": "WEB_ORIGIN"
                  }
                }
              },
              {
                "name": "TRUSTED_PROXY_IP",
                "valueFrom": {
                  "configMapKeyRef": {
                    "name": "vlp-runtime",
                    "key": "TRUSTED_PROXY_IP"
                  }
                }
              },
              {
                "name": "RELEASE_ENVIRONMENT",
                "valueFrom": {
                  "configMapKeyRef": {
                    "name": "vlp-runtime",
                    "key": "RELEASE_ENVIRONMENT"
                  }
                }
              },
              {
                "name": "RELEASE_POLICY_FILE",
                "value": "/run/vlp-policy/release.json"
              },
              {
                "name": "RUNTIME_WORLD_POLICY_FILE",
                "value": "/run/vlp-policy/runtime-worlds.json"
              },
              {
                "name": "SAFETY_POLICY_FILE",
                "value": "/run/vlp-policy/safety.json"
              },
              {
                "name": "DATABASE_URL",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "vlp-runtime-secrets",
                    "key": "DATABASE_URL"
                  }
                }
              },
              {
                "name": "SESSION_SECRET",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "vlp-runtime-secrets",
                    "key": "SESSION_SECRET"
                  }
                }
              },
              {
                "name": "SAFETY_EVIDENCE_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "vlp-runtime-secrets",
                    "key": "SAFETY_EVIDENCE_KEY",
                    "optional": true
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "256Mi"
              },
              "limits": {
                "cpu": "1000m",
                "memory": "768Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "startupProbe": {
              "exec": {
                "command": [
                  "node",
                  "-e",
                  "fetch('http://127.0.0.1:4300/health/live',{signal:AbortSignal.timeout(1500)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
                ]
              },
              "periodSeconds": 3,
              "timeoutSeconds": 3,
              "failureThreshold": 40
            },
            "livenessProbe": {
              "exec": {
                "command": [
                  "node",
                  "-e",
                  "fetch('http://127.0.0.1:4300/health/live',{signal:AbortSignal.timeout(1500)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
                ]
              },
              "periodSeconds": 3,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "readinessProbe": {
              "exec": {
                "command": [
                  "node",
                  "-e",
                  "fetch('http://127.0.0.1:4300/health/ready',{signal:AbortSignal.timeout(1500)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
                ]
              },
              "periodSeconds": 3,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "volumeMounts": [
              {
                "name": "tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "policy",
                "mountPath": "/run/vlp-policy",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "16Mi"
            }
          },
          {
            "name": "policy",
            "configMap": {
              "name": "vlp-installation-policy",
              "items": [
                {
                  "key": "release.json",
                  "path": "release.json"
                },
                {
                  "key": "runtime-worlds.json",
                  "path": "runtime-worlds.json"
                },
                {
                  "key": "safety.json",
                  "path": "safety.json"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
