{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "vlp-web-to-api",
    "labels": {
      "app.kubernetes.io/part-of": "virtual-life-platform"
    }
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app.kubernetes.io/part-of": "virtual-life-platform",
        "app.kubernetes.io/name": "vlp-web"
      }
    },
    "policyTypes": [
      "Egress"
    ],
    "egress": [
      {
        "to": [
          {
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/part-of": "virtual-life-platform",
                "app.kubernetes.io/name": "vlp-api"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 4300
          }
        ]
      }
    ]
  }
}
