{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "vlp-web",
    "labels": {
      "app.kubernetes.io/part-of": "virtual-life-platform",
      "app.kubernetes.io/name": "vlp-web"
    }
  },
  "spec": {
    "replicas": 1,
    "revisionHistoryLimit": 2,
    "progressDeadlineSeconds": 180,
    "strategy": {
      "type": "RollingUpdate",
      "rollingUpdate": {
        "maxSurge": 1,
        "maxUnavailable": 0
      }
    },
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/part-of": "virtual-life-platform",
        "app.kubernetes.io/name": "vlp-web"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/part-of": "virtual-life-platform",
          "app.kubernetes.io/name": "vlp-web"
        }
      },
      "spec": {
        "serviceAccountName": "vlp-runtime",
        "automountServiceAccountToken": false,
        "enableServiceLinks": false,
        "hostNetwork": false,
        "nodeSelector": {
          "kubernetes.io/os": "linux",
          "kubernetes.io/arch": "amd64"
        },
        "imagePullSecrets": [
          {
            "name": "vlp-registry-pull"
          }
        ],
        "terminationGracePeriodSeconds": 20,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "web",
            "image": "registry.invalid/vlp-web:release-required",
            "imagePullPolicy": "Always",
            "command": [
              "node",
              "start-runtime.mjs"
            ],
            "ports": [
              {
                "name": "http",
                "containerPort": 3300
              }
            ],
            "env": [
              {
                "name": "NODE_ENV",
                "value": "production"
              },
              {
                "name": "HOSTNAME",
                "value": "0.0.0.0"
              },
              {
                "name": "PORT",
                "value": "3300"
              },
              {
                "name": "NEXT_TELEMETRY_DISABLED",
                "value": "1"
              },
              {
                "name": "API_INTERNAL_URL",
                "value": "http://vlp-api:4300"
              },
              {
                "name": "PUBLIC_SOCKET_ORIGIN",
                "valueFrom": {
                  "configMapKeyRef": {
                    "name": "vlp-runtime",
                    "key": "WEB_ORIGIN"
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "400m",
                "memory": "512Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "startupProbe": {
              "tcpSocket": {
                "port": "http"
              },
              "periodSeconds": 3,
              "timeoutSeconds": 3,
              "failureThreshold": 40
            },
            "livenessProbe": {
              "tcpSocket": {
                "port": "http"
              },
              "periodSeconds": 5,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": "http"
              },
              "periodSeconds": 3,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "volumeMounts": [
              {
                "name": "tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "cache",
                "mountPath": "/app/apps/portal-web/.next/cache"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "16Mi"
            }
          },
          {
            "name": "cache",
            "emptyDir": {
              "sizeLimit": "64Mi"
            }
          }
        ]
      }
    }
  }
}
