FROM node:26.9.0-bookworm-slim@sha256:582460f614631b59b824ac6020533b9bf339c7fdf3a6d7db31abb6b4065f0212
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=development
WORKDIR /app
RUN npm install --global pnpm@11.28.5
COPY --chown=node:node . .
RUN pnpm install --frozen-lockfile && pnpm build:packages && pnpm --filter @virtual-city/platform-api build
USER node
CMD ["node", "apps/platform-api/dist/main.js"]
