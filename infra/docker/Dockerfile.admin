FROM node:26.9.0-bookworm-slim@sha256:582460f614631b59b824ac6020533b9bf339c7fdf3a6d7db31abb6b4065f0212 AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN npm install --global pnpm@11.28.5
COPY . .
RUN pnpm install --frozen-lockfile
# Synthetic build markers prove configuration is read at runtime and kept out of static assets.
RUN VLP_ADMIN_STANDALONE=1 ADMIN_ORIGIN=https://build-only-admin.invalid ADMIN_API_ORIGIN=http://build-only-admin-api.invalid:4300 ADMIN_METRICS_READ_TOKEN=abababababababababababababababababababababababababababababababab pnpm build

FROM node:26.9.0-bookworm-slim@sha256:582460f614631b59b824ac6020533b9bf339c7fdf3a6d7db31abb6b4065f0212 AS runtime
ARG SOURCE_REVISION
LABEL org.opencontainers.image.title="vlp-admin" org.opencontainers.image.revision=$SOURCE_REVISION
WORKDIR /app
RUN rm -rf /usr/local/lib/node_modules /opt/yarn-* /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/pnpm /usr/local/bin/corepack
COPY --from=build /app/apps/admin-web/.next/standalone/ ./
COPY --from=build /app/apps/admin-web/.next/static/ ./apps/admin-web/.next/static/
COPY --from=build /app/apps/admin-web/start-runtime.mjs ./apps/admin-web/start-runtime.mjs
COPY --from=build /app/apps/admin-web/server/runtime-config.mjs ./apps/admin-web/server/runtime-config.mjs
WORKDIR /app/apps/admin-web
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3400 NEXT_TELEMETRY_DISABLED=1
USER node
EXPOSE 3400
CMD ["node", "start-runtime.mjs"]
