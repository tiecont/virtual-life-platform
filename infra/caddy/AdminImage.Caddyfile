{
	admin off
	auto_https disable_redirects
	grace_period 5s
	log default {
		level ERROR
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				request>client_ip delete
			}
		}
	}
}

{$CITY_SITE_ADDRESS} {
	tls {$CITY_TLS_CERT} {$CITY_TLS_KEY}
	header -Server
	# This disposable edge exposes only the admin frontend/BFF; never the API.
	@backend path /v1 /v1/* /internal /internal/* /socket.io /socket.io/* /health/*
	handle @backend {
		respond 404
	}
	handle {
		reverse_proxy {$CITY_ADMIN_UPSTREAM:admin:3400} {
			header_up -Forwarded
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {hostport}
		}
	}
}
