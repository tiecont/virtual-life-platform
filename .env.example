# Local development only. Export these or use Node --env-file=.env.
# Compose requires POSTGRES_PASSWORD in your environment; generate it locally.
POSTGRES_USER=virtual_city
POSTGRES_DB=virtual_city_dev
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://virtual_city:REPLACE_LOCAL_PASSWORD@127.0.0.1:55452/virtual_city_dev
HOST=127.0.0.1
PORT=4300
WEB_ORIGIN=http://127.0.0.1:3300
API_INTERNAL_URL=http://127.0.0.1:4300
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_SECONDS=2592000
PUBLIC_SOCKET_ORIGIN=http://127.0.0.1:4300
# Optional owner-approved offline Deadline identity association, default OFF.
# LOCAL_DEADLINE_IDENTITY=1
# DEADLINE_LEGACY_API_URL=http://127.0.0.1:4400
# Requires the independently prepared Deadline copy, not an original app/database.
# LOCAL_DEADLINE_WORLD=1 installs the selected-source Deadline scene and shared Room/Focus module in dev/test; also requires deadline:true in WORLD_FLAGS_FILE. Default OFF; rejected in production.
# LOCAL_MAID_WORLD=1 installs the selected-source Maid shared Room/Hospitality adapter in dev/test; also requires maid:true in WORLD_FLAGS_FILE. Default OFF; rejected in production. Native scene/service acceptance remains M16-03..06.
# Optional trusted local JSON file. Reload API process with SIGHUP after editing.
# WORLD_FLAGS_FILE=/absolute/path/to/world-flags.json
# LOCAL_TRAVEL_FIXTURES=1 enables explicitly synthetic travel targets only in dev/test; requires matching flags, rejected in production.
# LOCAL_LIBRARY_WORLD=1 installs the original local Library module in dev/test; also requires library:true in WORLD_FLAGS_FILE. Rejected in production; defaults OFF.
# LOCAL_PARK_WORLD=1 installs the original local Park module in dev/test; also requires park:true in WORLD_FLAGS_FILE. Rejected in production; defaults OFF.
# LOCAL_RESTAURANT_WORLD=1 installs the original local Restaurant module in dev/test; also requires restaurant:true in WORLD_FLAGS_FILE. Rejected in production; defaults OFF.

# Optional versioned installation profile; all three fields are required together.
# Keep WORLD_FLAGS_FILE and LOCAL_* fixture controls unset in this profile.
# RELEASE_ENVIRONMENT=production
# RELEASE_POLICY_FILE=/reviewed/config/release-policy.json
# RUNTIME_WORLD_POLICY_FILE=/reviewed/runtime/world-policy.json
# SAFETY_POLICY_FILE=/reviewed/config/safety-policy-v2.json
# Git entitlement changes require process rollout; SIGHUP reloads bounded runtime policy only.

# Optional image-bound schema compatibility manifest. Absence uses exact image checksums.
# SCHEMA_COMPATIBILITY_FILE=/reviewed/config/schema-compatibility.json
# An expanded window requires the exact reviewed SQL checksum suffix and separate image proof.

# Optional 32-byte hex AES key; local legacy reports or explicitly reviewed v2 profile only.
# Keep stable across restarts and separate from SESSION_SECRET. Never commit an actual key.
# SAFETY_EVIDENCE_KEY=
SAFETY_EVIDENCE_KEY_ID=local-v1
