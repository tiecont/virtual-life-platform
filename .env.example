# Local development only. Export these or use Node --env-file=.env.
# Compose requires POSTGRES_PASSWORD in your environment; generate it locally.
POSTGRES_USER=virtual_city
POSTGRES_DB=virtual_city_dev
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://virtual_city:REPLACE_LOCAL_PASSWORD@127.0.0.1:55452/virtual_city_dev
HOST=127.0.0.1
PORT=4300
WEB_ORIGIN=http://127.0.0.1:3300
API_INTERNAL_URL=http://127.0.0.1:4300
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_SECONDS=2592000
PUBLIC_SOCKET_ORIGIN=http://127.0.0.1:4300
# Optional trusted local JSON file. Reload API process with SIGHUP after editing.
# WORLD_FLAGS_FILE=/absolute/path/to/world-flags.json
# LOCAL_TRAVEL_FIXTURES=1 enables explicitly synthetic travel targets only in dev/test; requires matching flags, rejected in production.
# LOCAL_LIBRARY_WORLD=1 installs the original local Library module in dev/test; also requires library:true in WORLD_FLAGS_FILE. Rejected in production; defaults OFF.
# LOCAL_RESTAURANT_WORLD=1 installs the original local Restaurant module in dev/test; also requires restaurant:true in WORLD_FLAGS_FILE. Rejected in production; defaults OFF.

# Optional 32-byte hex AES key; enables local confidential reports only (not production).
# Keep stable across restarts and separate from SESSION_SECRET. Never commit an actual key.
# SAFETY_EVIDENCE_KEY=
SAFETY_EVIDENCE_KEY_ID=local-v1
