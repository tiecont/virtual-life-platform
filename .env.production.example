# TEMPLATE ONLY. Copy to ignored .env.production and populate from the owner's
# private secret store. No value below is a working credential or public domain.
NODE_ENV=production
HOST=127.0.0.1
PORT=4300
WEB_ORIGIN=https://REPLACE_WITH_AETHERIA_PORTAL_ORIGIN
ADMIN_ORIGIN=https://REPLACE_WITH_AETHERIA_ADMIN_ORIGIN
API_INTERNAL_URL=http://127.0.0.1:4300
PUBLIC_SOCKET_ORIGIN=https://REPLACE_WITH_AETHERIA_API_ORIGIN
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_SECONDS=2592000

# Managed PostgreSQL remains the source of truth.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE

# Production Redis is cache/coordination support only. It cannot become a game
# or room authority. Set both values together from the Upstash console.
UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_UPSTASH_REST_ENDPOINT
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REST_TOKEN

# Private Cloudflare R2 bucket through its S3-compatible endpoint.
S3_ENDPOINT=https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
S3_BUCKET=REPLACE_WITH_PRIVATE_R2_ASSET_BUCKET
S3_REGION=auto

# Cloudflare account/deployment placeholders. Keep API tokens only in the
# private environment or CI secret store; never commit a populated file.
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN

# Native Android auth remains a separate, default-off transport.
NATIVE_AUTH_ENABLED=0
NATIVE_AUTH_KEY=

# Public release, registration, purchases, and deployment remain unauthorized
# until the repository's separate owner gates are satisfied.
